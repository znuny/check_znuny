{
    "Command": {
        "znuny_health": {
            "arguments": {
                "--url": {
                    "description": "Full URL of the HealthStatusGet endpoint.",
                    "required": true,
                    "value": "$znuny_healthstatus_url$"
                },
                "--section": {
                    "description": "Which part of the response to evaluate: daemon, commlog, cron, genericagent, future-tasks, unprocessed-emails, system.",
                    "required": true,
                    "value": "$znuny_health_section$"
                },
                "--api-key": {
                    "description": "API key configured in SysConfig 'Znuny::HealthStatus::API::Key'.",
                    "value": "$znuny_healthstatus_api_key$"
                },
                "--api-key-file": {
                    "description": "Path to a file containing the API key, as an alternative to --api-key.",
                    "value": "$znuny_healthstatus_api_key_file$"
                },
                "--log-hours": {
                    "description": "Hours of communication log history to evaluate. Only relevant for --section commlog.",
                    "value": "$znuny_health_log_hours$"
                },
                "--timeout": {
                    "description": "HTTP request timeout in seconds.",
                    "value": "$znuny_health_timeout$"
                },
                "--insecure": {
                    "description": "Skip TLS certificate verification.",
                    "set_if": "$znuny_health_insecure$"
                },
                "--no-proxy": {
                    "description": "Ignore proxy environment variables.",
                    "set_if": "$znuny_health_no_proxy$"
                },
                "--warning": {
                    "description": "Warning threshold (Nagios range). Meaning depends on --section: failed-entry count (cron/genericagent), Failed count (commlog), queue length (future-tasks/system).",
                    "value": "$znuny_health_warning$"
                },
                "--critical": {
                    "description": "Critical threshold (Nagios range). See --warning.",
                    "value": "$znuny_health_critical$"
                },
                "--warning-runtime": {
                    "description": "(--section genericagent only) Warning threshold in seconds for a task's last run duration.",
                    "value": "$znuny_health_warning_runtime$"
                },
                "--critical-runtime": {
                    "description": "(--section genericagent only) Critical threshold in seconds for a task's last run duration.",
                    "value": "$znuny_health_critical_runtime$"
                }
            },
            "command": "check_znuny.py",
            "disabled": false,
            "fields": [
                { "datafield_id": 1,  "is_required": "y", "var_filter": null },
                { "datafield_id": 2,  "is_required": "y", "var_filter": null },
                { "datafield_id": 3,  "is_required": "n", "var_filter": null },
                { "datafield_id": 4,  "is_required": "n", "var_filter": null },
                { "datafield_id": 5,  "is_required": "n", "var_filter": null },
                { "datafield_id": 6,  "is_required": "n", "var_filter": null },
                { "datafield_id": 7,  "is_required": "n", "var_filter": null },
                { "datafield_id": 8,  "is_required": "n", "var_filter": null },
                { "datafield_id": 9,  "is_required": "n", "var_filter": null },
                { "datafield_id": 10, "is_required": "n", "var_filter": null },
                { "datafield_id": 11, "is_required": "n", "var_filter": null },
                { "datafield_id": 12, "is_required": "n", "var_filter": null }
            ],
            "imports": [],
            "is_string": null,
            "methods_execute": "PluginCheck",
            "object_name": "znuny_health",
            "object_type": "object",
            "timeout": "60",
            "vars": {
                "znuny_health_timeout": "10"
            },
            "zone": null
        }
    },
    "Datafield": {
