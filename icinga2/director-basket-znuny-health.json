        "2":  { "category_id": null, "varname": "znuny_health_section",         "caption": "Znuny Health: Section",                  "description": "daemon, commlog, cron, genericagent, future-tasks, unprocessed-emails, or system.", "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString", "format": null, "originalId": "2",  "settings": {} },
        "3":  { "category_id": null, "varname": "znuny_healthstatus_api_key",   "caption": "Znuny Health: API key",                  "description": "API key configured in SysConfig 'Znuny::HealthStatus::API::Key'.",      "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString", "format": null, "originalId": "3",  "settings": {} },
        "4":  { "category_id": null, "varname": "znuny_healthstatus_api_key_file", "caption": "Znuny Health: API key file",         "description": "Path to a file containing the API key (alternative to the API key field).", "datatype": "Icinga\\Module\\Director\\DataType\\DataTypeString", "format": null, "originalId": "4",  "settings": {} },
